{
  "schema_version": 1,
  "product_id": "beep",
  "display_name": "Beep",
  "authority_summary": "Private root-capable AI Systems Administrator with Beep-owned policy, approval, audit, lifecycle, and operator controls",
  "source_root": "products/beep",
  "version_file": "VERSION",
  "lifecycle_script": "scripts/manage.sh",
  "installed_entrypoint": "/usr/local/sbin/beep-manage",
  "install_root": "/opt/beep",
  "configuration_root": "/etc/beep",
  "state_root": "/var/lib/beep",
  "log_root": "/var/log/beep",
  "ownership_marker": "/var/lib/beep/installation.json",
  "environment_prefix": "BEEP",
  "accounts": [
    {
      "name": "beep",
      "kind": "user"
    },
    {
      "name": "beep",
      "kind": "group"
    }
  ],
  "units": [
    "beep-chat.service",
    "beep-health.service",
    "beep-health.timer"
  ],
  "ports": [
    {
      "address": "127.0.0.1",
      "port": 58989,
      "protocol": "tcp"
    }
  ],
  "cookie_names": [
    "beep_session"
  ],
  "operations": [
    "describe",
    "status",
    "install",
    "verify",
    "doctor",
    "repair",
    "backup",
    "update",
    "rollback",
    "suspend",
    "resume",
    "kill",
    "uninstall"
  ]
}
