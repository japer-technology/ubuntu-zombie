#!/usr/bin/env bash
# beep-chat — print the local chat URL and the
# operator's debugging entry points. This is the single command a
# tester should run to discover every diagnostic surface the payload
# ships with.
set -euo pipefail

usage() {
  cat <<EOF
beep-chat — print the local chat URL and every diagnostic entry point.

Usage:
  beep-chat [-h|--help]

Environment:
  BEEP_CHAT_PORT    Chat port to show in the URL (default 58989).
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) echo "beep-chat: unknown argument: $1" >&2; usage >&2; exit 2 ;;
esac

PORT="${BEEP_CHAT_PORT:-58989}"
cat <<EOF
Beep
-------------

Local URL:
  http://127.0.0.1:${PORT}/

Service control:
  sudo systemctl status beep-chat.service
  sudo systemctl restart beep-chat.service
  sudo journalctl -u beep-chat.service -f

Health and diagnostics:
  beep-health                       # one-shot health summary
  beep-diagnostics                  # bundle redacted logs + state for bug reports
  sudo beep-secrets-edit                # safely edit provider keys

Audit log:
  beep-audit-recent                   # last 25 entries (pretty)
  beep-audit-recent -f                # stream new entries (tail -F)
  beep-audit-recent -t tool_call -t provider_error
  beep-audit-recent --all             # full log

Independent product manager:
  sudo /opt/beep/bin/beep-agents --json list

Verbose audit (for testing only — opt in on the chat service):
  sudo systemctl edit beep-chat.service
    # add: [Service]
    #      Environment=BEEP_AUDIT_VERBOSE=1
  sudo systemctl restart beep-chat.service
  # tool_call entries then include redacted stdout/stderr previews.

EOF
