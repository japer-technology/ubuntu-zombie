#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage: friend-diagnostics [--output-directory PATH]

Create a content-free Imaginary Friend diagnostic archive. Conversation text,
workspace file contents, password hashes, session material, and signing keys
are excluded.
EOF
}

output_directory="${PWD}"
while (($#)); do
  case "$1" in
    --output-directory)
      (($# >= 2)) || { echo "--output-directory needs a path" >&2; exit 2; }
      output_directory="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[[ "${output_directory}" = /* ]] \
  || { echo "Output directory must be absolute." >&2; exit 2; }
[[ -d "${output_directory}" && ! -L "${output_directory}" ]] \
  || { echo "Output directory must be an existing non-symlink directory." >&2; exit 1; }

staging="$(mktemp -d)"
cleanup() {
  rm -rf "${staging}"
}
trap cleanup EXIT

if [[ -r /etc/imaginary-friend/PRODUCT.json ]]; then
  cp /etc/imaginary-friend/PRODUCT.json "${staging}/PRODUCT.json"
fi
if [[ -r /var/lib/imaginary-friend/installation.json ]]; then
  cp /var/lib/imaginary-friend/installation.json "${staging}/installation.json"
fi
if command -v friend-manage >/dev/null 2>&1; then
  friend-manage doctor --json > "${staging}/doctor.json" 2> "${staging}/doctor.stderr" || true
fi
if command -v systemctl >/dev/null 2>&1; then
  systemctl show imaginary-friend-chat.service \
    --property=ActiveState,SubState,UnitFileState,FragmentPath \
    > "${staging}/service.txt" 2>&1 || true
fi
if [[ -r /etc/systemd/system/imaginary-friend-chat.service ]]; then
  grep -E '^(User|Group|NoNewPrivileges|Private|Protect|Restrict|Capability|IPAddress|ReadWritePaths|InaccessiblePaths)=' \
    /etc/systemd/system/imaginary-friend-chat.service \
    > "${staging}/sandbox.txt" || true
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
archive="${output_directory}/imaginary-friend-diagnostics-${timestamp}.tar.gz"
tar -czf "${archive}" -C "${staging}" .
chmod 600 "${archive}"
printf '%s\n' "${archive}"
