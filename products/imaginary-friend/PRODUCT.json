{
  "schema_version": 1,
  "product_id": "imaginary-friend",
  "display_name": "Imaginary Friend",
  "authority_summary": "Private conversation and explicit file operations inside Friend state and nominated workspaces only",
  "source_root": "products/imaginary-friend",
  "version_file": "VERSION",
  "lifecycle_script": "scripts/manage.sh",
  "installed_entrypoint": "/usr/local/sbin/friend-manage",
  "install_root": "/opt/imaginary-friend",
  "configuration_root": "/etc/imaginary-friend",
  "state_root": "/var/lib/imaginary-friend",
  "log_root": "/var/log/imaginary-friend",
  "ownership_marker": "/var/lib/imaginary-friend/installation.json",
  "environment_prefix": "FRIEND",
  "accounts": [
    {
      "name": "friend",
      "kind": "user"
    },
    {
      "name": "friend",
      "kind": "group"
    },
    {
      "name": "friend-share",
      "kind": "group"
    }
  ],
  "units": [
    "imaginary-friend-chat.service"
  ],
  "ports": [
    {
      "address": "127.0.0.1",
      "port": 6767,
      "protocol": "tcp"
    }
  ],
  "cookie_names": [
    "imaginary_friend_session"
  ],
  "operations": [
    "describe",
    "status",
    "install",
    "verify",
    "doctor",
    "repair",
    "backup",
    "update",
    "rollback",
    "suspend",
    "resume",
    "uninstall"
  ]
}
