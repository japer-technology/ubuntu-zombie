#!/usr/bin/env python3
"""Operate the product-owned, PC-wide llama.cpp service."""

from __future__ import annotations

import argparse
import json
import os
import platform
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


CONFIG_PATH = Path("/etc/llama.cpp/config.json")
INSTALL_ROOT = Path("/opt/llama.cpp")
STATE_ROOT = Path("/var/lib/llama.cpp")
UNIT = "llama-server.service"
CONFIG_KEYS = {
    "schema_version",
    "port",
    "model_id",
    "model_path",
    "context_size",
    "threads",
    "runtime_release",
    "runtime_dir",
}


def _within(path: Path, root: Path) -> bool:
    try:
        path.resolve(strict=False).relative_to(root.resolve(strict=False))
    except ValueError:
        return False
    return True


def load_config() -> dict[str, Any]:
    """Load and validate the product-owned standalone configuration."""
    try:
        value = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"cannot read {CONFIG_PATH}: {exc}") from exc
    if not isinstance(value, dict) or set(value) != CONFIG_KEYS:
        raise RuntimeError(f"{CONFIG_PATH} has an unsupported schema")
    if value["schema_version"] != 1 or value["port"] != 8080:
        raise RuntimeError(f"{CONFIG_PATH} has an unsupported schema")
    for name in ("context_size", "threads"):
        if isinstance(value[name], bool) or not isinstance(value[name], int):
            raise RuntimeError(f"{CONFIG_PATH} has an invalid {name}")
    if not 512 <= value["context_size"] <= 1_048_576:
        raise RuntimeError(f"{CONFIG_PATH} has an invalid context_size")
    if not 1 <= value["threads"] <= 1024:
        raise RuntimeError(f"{CONFIG_PATH} has an invalid threads")
    for name in ("model_id", "runtime_release"):
        if not isinstance(value[name], str) or not value[name]:
            raise RuntimeError(f"{CONFIG_PATH} has an invalid {name}")
    runtime = Path(value["runtime_dir"])
    model = Path(value["model_path"])
    if not runtime.is_absolute() or not _within(runtime, INSTALL_ROOT):
        raise RuntimeError(f"{CONFIG_PATH} has an unsafe runtime_dir")
    if not model.is_absolute() or not _within(model, STATE_ROOT / "models"):
        raise RuntimeError(f"{CONFIG_PATH} has an unsafe model_path")
    return value


def systemctl(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    """Run systemctl for the fixed Llama unit."""
    return subprocess.run(
        ["systemctl", *args, UNIT],
        check=check,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
    )


def service_property(name: str) -> str:
    """Read one systemd property without failing when systemd is unavailable."""
    result = systemctl("show", f"--property={name}", "--value", check=False)
    return result.stdout.strip() if result.returncode == 0 else "unknown"


def api_request(path: str, method: str = "GET", body: bytes | None = None) -> Any:
    """Call the fixed loopback API with a bounded request and response."""
    if not path.startswith("/") or "\r" in path or "\n" in path:
        raise RuntimeError("invalid API path")
    config = load_config()
    url = f"http://127.0.0.1:{config['port']}{path}"
    request = urllib.request.Request(
        url,
        data=body,
        method=method,
        headers={"Accept": "application/json", "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        data = response.read(1024 * 1024 + 1)
    if len(data) > 1024 * 1024:
        raise RuntimeError("llama API response is too large")
    return json.loads(data)


def status_payload() -> dict[str, Any]:
    """Return stable machine-readable service status."""
    config = load_config()
    active = service_property("ActiveState")
    enabled = systemctl("is-enabled", check=False).stdout.strip() or "unknown"
    healthy = False
    if active == "active":
        try:
            api_request("/health")
            healthy = True
        except (OSError, RuntimeError, ValueError, urllib.error.URLError):
            healthy = False
    state = (
        "ready"
        if healthy
        else "installed-stopped"
        if active == "inactive"
        else active
    )
    return {
        "state": state,
        "active": active,
        "enabled": enabled,
        "healthy": healthy,
        "url": f"http://127.0.0.1:{config['port']}/v1",
        "model": config["model_id"],
        "runtime": config["runtime_release"],
    }


def print_status(as_json: bool) -> int:
    """Print service status."""
    payload = status_payload()
    if as_json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(f"State:   {payload['state']}")
        print(f"API:     {payload['url']}")
        print(f"Model:   {payload['model']}")
        print(f"Runtime: {payload['runtime']}")
        print(f"Boot:    {payload['enabled']}")
    return 0 if payload["healthy"] else 1


def mutate(command: str) -> int:
    """Apply a fixed systemd lifecycle operation."""
    if os.geteuid() != 0:
        print(f"llama-manager {command} requires root", file=sys.stderr)
        return 1
    result = systemctl(command, check=False)
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
    return result.returncode


def print_models(as_json: bool) -> int:
    """List models advertised by the server."""
    try:
        payload = api_request("/v1/models")
    except (OSError, RuntimeError, ValueError, urllib.error.URLError) as exc:
        print(f"llama API unavailable: {exc}", file=sys.stderr)
        return 1
    rows = payload.get("data", []) if isinstance(payload, dict) else []
    models = [
        row["id"]
        for row in rows
        if isinstance(row, dict) and isinstance(row.get("id"), str)
    ]
    print(json.dumps(models) if as_json else "\n".join(models))
    return 0


def test_api() -> int:
    """Run a bounded OpenAI-compatible inference probe."""
    config = load_config()
    body = json.dumps(
        {
            "model": config["model_id"],
            "messages": [{"role": "user", "content": "Reply with OK."}],
            "max_tokens": 8,
            "temperature": 0,
        }
    ).encode()
    try:
        payload = api_request("/v1/chat/completions", "POST", body)
    except (OSError, RuntimeError, ValueError, urllib.error.URLError) as exc:
        print(f"llama API test failed: {exc}", file=sys.stderr)
        return 1
    choices = payload.get("choices") if isinstance(payload, dict) else None
    if not isinstance(choices, list) or not choices:
        print("llama API returned no completion", file=sys.stderr)
        return 1
    print("llama API test passed")
    return 0


def print_hardware(as_json: bool) -> int:
    """Print non-sensitive CPU and memory capacity."""
    memory_kib = 0
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                memory_kib = int(line.split()[1])
                break
    except (OSError, ValueError, IndexError):
        pass
    payload = {
        "architecture": platform.machine(),
        "logical_cpus": os.cpu_count(),
        "memory_bytes": memory_kib * 1024,
        "compute": "cpu",
    }
    if as_json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(f"Architecture: {payload['architecture']}")
        print(f"Logical CPUs: {payload['logical_cpus']}")
        print(f"Memory:       {payload['memory_bytes']} bytes")
        print("Compute:      cpu")
    return 0


def serve() -> None:
    """Replace this process with the pinned managed llama-server."""
    config = load_config()
    runtime = Path(config["runtime_dir"])
    executable = runtime / "llama-server"
    model = Path(config["model_path"])
    if not executable.is_file() or not os.access(executable, os.X_OK):
        raise RuntimeError("managed runtime is missing or not executable")
    if not model.is_file():
        raise RuntimeError("managed model is missing")
    args = [
        str(executable),
        "--host",
        "127.0.0.1",
        "--port",
        str(config["port"]),
        "--model",
        str(model),
        "--ctx-size",
        str(config["context_size"]),
        "--threads",
        str(config["threads"]),
        "--alias",
        str(config["model_id"]),
    ]
    current_library_path = os.environ.get("LD_LIBRARY_PATH", "")
    os.environ["LD_LIBRARY_PATH"] = (
        f"{runtime}:{current_library_path}" if current_library_path else str(runtime)
    )
    os.execv(executable, args)


def main() -> int:
    """CLI entry point."""
    parser = argparse.ArgumentParser(prog="llama-manager")
    parser.add_argument("--json", action="store_true")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in (
        "status",
        "start",
        "stop",
        "restart",
        "enable",
        "disable",
        "test",
        "models",
        "hardware",
    ):
        subparsers.add_parser(command)
    subparsers.add_parser("serve", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.command == "status":
        return print_status(args.json)
    if args.command in {"start", "stop", "restart", "enable", "disable"}:
        return mutate(args.command)
    if args.command == "test":
        return test_api()
    if args.command == "models":
        return print_models(args.json)
    if args.command == "hardware":
        return print_hardware(args.json)
    if args.command == "serve":
        serve()
        return 0
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except RuntimeError as exc:
        print(f"llama-manager: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
