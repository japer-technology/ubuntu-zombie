{
  "schema_version": 1,
  "product_id": "forgejo",
  "display_name": "Forgejo",
  "authority_summary": "Host a private PostgreSQL-backed git forge behind a local Caddy HTTPS boundary",
  "source_root": "products/forgejo",
  "version_file": "VERSION",
  "lifecycle_script": "scripts/manage.sh",
  "installed_entrypoint": "/usr/local/sbin/forgejo-manage",
  "install_root": "/opt/forgejo",
  "configuration_root": "/etc/forgejo",
  "state_root": "/var/lib/forgejo",
  "log_root": "/var/log/forgejo",
  "ownership_marker": "/var/lib/forgejo/installation.json",
  "environment_prefix": "FORGEJO",
  "accounts": [
    {
      "name": "git",
      "kind": "user"
    },
    {
      "name": "git",
      "kind": "group"
    }
  ],
  "units": [
    "forgejo.service"
  ],
  "ports": [
    {
      "address": "127.0.0.1",
      "port": 3000,
      "protocol": "tcp"
    }
  ],
  "cookie_names": [
    "forgejo_session",
    "forgejo_remember"
  ],
  "operations": [
    "describe",
    "status",
    "install",
    "verify",
    "doctor",
    "repair",
    "backup",
    "update",
    "rollback",
    "suspend",
    "resume",
    "uninstall"
  ]
}
