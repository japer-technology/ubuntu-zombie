{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/japer-technology/ubuntu-zombie/raw/main/family/schemas/product-v1.schema.json",
  "title": "Ubuntu Zombie family product descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "display_name",
    "authority_summary",
    "source_root",
    "version_file",
    "lifecycle_script",
    "installed_entrypoint",
    "install_root",
    "configuration_root",
    "state_root",
    "log_root",
    "ownership_marker",
    "environment_prefix",
    "accounts",
    "units",
    "ports",
    "cookie_names",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "enum": [
        "imaginary-friend",
        "curriculum-flame",
        "eric",
        "forgejo",
        "llama",
        "beep"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "authority_summary": {
      "type": "string",
      "minLength": 1
    },
    "source_root": {
      "type": "string",
      "pattern": "^products/(imaginary-friend|curriculum-flame|eric|forgejo|llama|beep)$"
    },
    "version_file": {
      "const": "VERSION"
    },
    "lifecycle_script": {
      "const": "scripts/manage.sh"
    },
    "installed_entrypoint": {
      "type": "string",
      "pattern": "^/usr/local/sbin/(friend|flame|eric|forgejo|llama|beep)-manage$"
    },
    "install_root": {
      "$ref": "#/$defs/absolute_path"
    },
    "configuration_root": {
      "$ref": "#/$defs/absolute_path"
    },
    "state_root": {
      "$ref": "#/$defs/absolute_path"
    },
    "log_root": {
      "$ref": "#/$defs/absolute_path"
    },
    "ownership_marker": {
      "$ref": "#/$defs/absolute_path"
    },
    "environment_prefix": {
      "enum": [
        "FRIEND",
        "FLAME",
        "ERIC",
        "FORGEJO",
        "LLAMA",
        "BEEP"
      ]
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
          },
          "kind": {
            "enum": [
              "user",
              "group"
            ]
          }
        }
      }
    },
    "units": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9@_.-]*\\.(service|socket|timer)$"
      }
    },
    "ports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "port",
          "protocol"
        ],
        "properties": {
          "address": {
            "enum": [
              "127.0.0.1",
              "::1"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp"
            ]
          }
        }
      }
    },
    "cookie_names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "describe",
          "status",
          "install",
          "verify",
          "doctor",
          "repair",
          "backup",
          "update",
          "rollback",
          "suspend",
          "resume",
          "kill",
          "uninstall"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product_id": {
            "const": "beep"
          }
        },
        "required": [
          "product_id"
        ]
      },
      "then": {
        "properties": {
          "operations": {
            "contains": {
              "const": "kill"
            }
          }
        }
      },
      "else": {
        "properties": {
          "operations": {
            "items": {
              "$ref": "#/$defs/shared_operation"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "absolute_path": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]*$"
    },
    "shared_operation": {
      "enum": [
        "describe",
        "status",
        "install",
        "verify",
        "doctor",
        "repair",
        "backup",
        "update",
        "rollback",
        "suspend",
        "resume",
        "uninstall"
      ]
    }
  }
}
