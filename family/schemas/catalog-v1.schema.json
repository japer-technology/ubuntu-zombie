{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/japer-technology/ubuntu-zombie/raw/main/family/schemas/catalog-v1.schema.json",
  "title": "Ubuntu Zombie family release catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "generated_at",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "const": "japer-technology/ubuntu-zombie"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/japer-technology/ubuntu-zombie/releases/download/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "descriptor",
        "version",
        "tag",
        "artifact",
        "sbom",
        "provenance",
        "signature_bundle",
        "certificate_identity"
      ],
      "properties": {
        "product_id": {
          "enum": [
            "imaginary-friend",
            "curriculum-flame",
            "eric",
            "forgejo",
            "llama",
            "beep"
          ]
        },
        "descriptor": {
          "type": "string",
          "pattern": "^products/(imaginary-friend|curriculum-flame|eric|forgejo|llama|beep)/PRODUCT\\.json$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^(imaginary-friend|curriculum-flame|eric|forgejo|llama|beep)-v[0-9]{4}(\\.[0-9]{2}){5}$"
        },
        "artifact": {
          "$ref": "#/$defs/asset"
        },
        "sbom": {
          "$ref": "#/$defs/asset"
        },
        "provenance": {
          "$ref": "#/$defs/asset"
        },
        "signature_bundle": {
          "$ref": "#/$defs/asset"
        },
        "certificate_identity": {
          "type": "string",
          "pattern": "^https://github\\.com/japer-technology/ubuntu-zombie/"
        }
      }
    }
  }
}
