{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/japer-technology/ubuntu-zombie/raw/main/family/schemas/response-v1.schema.json",
  "title": "Ubuntu Zombie family lifecycle response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "product_version",
    "instance_id",
    "operation",
    "phase",
    "correlation_id",
    "status",
    "changed",
    "plan_digest",
    "requires_confirmation",
    "required_inputs",
    "steps",
    "checks",
    "receipt",
    "errors",
    "recovery"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "enum": [
        "imaginary-friend",
        "curriculum-flame",
        "eric",
        "forgejo",
        "llama",
        "beep"
      ]
    },
    "product_version": {
      "$ref": "#/$defs/version"
    },
    "instance_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "phase": {
      "enum": [
        "read",
        "plan",
        "execute"
      ]
    },
    "correlation_id": {
      "$ref": "#/$defs/uuid"
    },
    "status": {
      "enum": [
        "ok",
        "degraded",
        "blocked",
        "unsupported",
        "failed"
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "plan_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "secret"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "secret": {
            "type": "boolean"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "mutates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "mutates": {
            "type": "boolean"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "digest"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/absolute_path"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product_id": {
            "const": "beep"
          }
        },
        "required": [
          "product_id"
        ]
      },
      "else": {
        "properties": {
          "operation": {
            "$ref": "#/$defs/shared_operation"
          }
        }
      }
    }
  ],
  "$defs": {
    "absolute_path": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\r\\n]*$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "summary",
        "remediation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "summary": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "enum": [
        "describe",
        "status",
        "install",
        "verify",
        "doctor",
        "repair",
        "backup",
        "update",
        "rollback",
        "suspend",
        "resume",
        "kill",
        "uninstall"
      ]
    },
    "shared_operation": {
      "enum": [
        "describe",
        "status",
        "install",
        "verify",
        "doctor",
        "repair",
        "backup",
        "update",
        "rollback",
        "suspend",
        "resume",
        "uninstall"
      ]
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$"
    }
  }
}
