{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/japer-technology/ubuntu-zombie/raw/main/family/schemas/audit-event-v1.schema.json",
  "title": "Ubuntu Zombie family lifecycle audit event v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "timestamp",
    "event_id",
    "correlation_id",
    "product_id",
    "instance_id",
    "operation",
    "phase",
    "actor",
    "decision",
    "result",
    "changed",
    "receipt_digest"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "product_id": {
      "enum": [
        "imaginary-friend",
        "curriculum-flame",
        "eric",
        "forgejo",
        "llama",
        "beep"
      ]
    },
    "instance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "read",
        "plan",
        "execute"
      ]
    },
    "actor": {
      "enum": [
        "operator",
        "ubuntu-zombie",
        "beep",
        "friend-owner",
        "friend-service"
      ]
    },
    "decision": {
      "enum": [
        "allowed",
        "denied"
      ]
    },
    "result": {
      "enum": [
        "ok",
        "degraded",
        "blocked",
        "unsupported",
        "failed"
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "receipt_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
